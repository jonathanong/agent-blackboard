{
  "$schema": "https://unpkg.com/knip/schema.json",
  "workspaces": {
    "packages/agent-journal": {
      "entry": ["src/index.mts!", "src/cli/index.mts!", "src/mcp/index.mts!"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"]
    },
    "packages/server": {
      "entry": ["src/handler.mts!", "src/local-server.mts!", "infra/*.mjs"],
      "project": ["src/**/*.mts!", "!src/**/*.test.mts!"]
    }
  },
  "ignoreDependencies": ["oxlint-tsgolint"]
}

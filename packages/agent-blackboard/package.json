{
  "name": "agent-blackboard",
  "version": "0.5.0",
  "description": "Client library, CLI, and MCP server for Agent Blackboard session entries.",
  "homepage": "https://github.com/jonathanong/agent-blackboard#readme",
  "bugs": {
    "url": "https://github.com/jonathanong/agent-blackboard/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathanong/agent-blackboard.git",
    "directory": "packages/agent-blackboard"
  },
  "bin": {
    "agent-blackboard": "dist/cli/index.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}

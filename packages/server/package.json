{
  "name": "agent-blackboard-server",
  "version": "0.0.0",
  "private": true,
  "description": "Lambda + DynamoDB server for Agent Blackboard. Deployed via CloudFormation, never published.",
  "type": "module",
  "scripts": {
    "build": "node infra/bundle.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "dev": "tsx src/local-server.mts",
    "deploy": "node infra/deploy.mjs",
    "teardown": "node infra/teardown.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1094.0",
    "@aws-sdk/lib-dynamodb": "^3.1094.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsx": "^4.22.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}

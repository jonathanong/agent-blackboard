{
  "name": "atel-workspace",
  "private": true,
  "description": "Agent Telemetry: a stream for autonomous agents to record findings for later self-review and distillation.",
  "homepage": "https://github.com/jonathanong/atel#readme",
  "bugs": {
    "url": "https://github.com/jonathanong/atel/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonathanong/atel"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm run oxlint && pnpm run oxfmt:check && pnpm run ast-grep && pnpm run knip && pnpm run dependency-cruiser",
    "oxlint": "oxlint --type-aware --deny-warnings",
    "oxlint:fix": "oxlint --type-aware --fix --deny-warnings",
    "oxfmt": "oxfmt",
    "oxfmt:check": "oxfmt --check",
    "ast-grep": "node scripts/run-ast-grep.mjs scan",
    "knip": "knip",
    "dependency-cruiser": "depcruise packages",
    "actionlint": "github-actionlint",
    "lint:links": "lychee --config lychee.toml '**/*.md' '**/*.json'"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.44.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "atel": "workspace:*",
    "dependency-cruiser": "^18.1.0",
    "github-actionlint": "^1.7.12",
    "knip": "^6.26.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.1.2"
}
